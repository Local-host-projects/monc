MONC_SECRET_KEY=replace-with-at-least-32-random-bytes
MONC_DATABASE_URL=sqlite:///./monc.db
MONC_COOKIE_SECURE=0
# sandbox = deterministic in-memory Wema (no credentials). playground/production = live ALAT API.
MONC_WEMA_MODE=sandbox

# Required for MONC_WEMA_MODE=playground (ALAT Playground) or production.
WEMA_SUBSCRIPTION_KEY=
WEMA_CHANNEL_ID=
WEMA_ACCOUNT_API_KEY=

# Override only if Wema serves these from a different host than
# https://apiplayground.alat.ng/{pwba-authenticator,debit-wallet,credit-wallet,ws-acct-mgt}
WEMA_PWBA_BASE_URL=
WEMA_DEBIT_BASE_URL=
WEMA_CREDIT_BASE_URL=
WEMA_ACCOUNT_BASE_URL=
